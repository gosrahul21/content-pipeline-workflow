# Server
PORT=4000

# LinkedIn App Credentials (OAuth 2.0)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/auth/linkedin/callback

# LinkedIn Member Credentials (Auto-filled via OAuth or manual)
LINKEDIN_MOCK_MODE=true
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# AWS S3 & EventBridge Scheduler (Option 1)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_EVENTBRIDGE_SCHEDULER_ENABLED=false
AWS_LAMBDA_TARGET_ARN=
AWS_SCHEDULER_ROLE_ARN=
